    sndBtn.setAttribute('aria-pressed', String(!muted));
    sndBtn.textContent = muted ? 'Crackle off' : 'Crackle on';
  });

  /* candy physics */
  var items = [], raf = 0, last = 0;
  var EMOJI = ['🪩', '💖', '🎧', '🍬', '✨', '🕺', '🫧', '🧃', '🌈', '🔊', '🪬', '💃'];

  function spawn(o) {
    var it = { x: 0, y: 0, vx: 0, vy: 0, r: 10, rot: 0, vr: 0, age: 0, life: 5, bounce: 0.6, type: 'candy', shape: 'lens', color: '#fff', m: false, ch: '' };
    for (var k in o) it[k] = o[k];
    items.push(it);
    if (items.length > 280) items.shift();
    if (!raf) { last = performance.now(); raf = requestAnimationFrame(tick); }
  }

  function tick(now) {
    var dt = Math.min((now - last) / 1000, 0.033);
    last = now;
    var rects = [];
    var obs = document.querySelectorAll('.obst');
    for (var i = 0; i < obs.length; i++) {
      var rc = obs[i].getBoundingClientRect();
      if (rc.bottom > 0 && rc.top < H && rc.width > 0) rects.push(rc);
    }
    for (var n = items.length - 1; n >= 0; n--) {
      var it = items[n];
      it.age += dt;
      if (it.age > it.life) { items.splice(n, 1); continue; }
      var g = it.type === 'spark' ? 1800 : it.type === 'emoji' ? 900 : 1500;
      it.vy += g * dt;
      it.x += it.vx * dt; it.y += it.vy * dt;
      it.rot += it.vr * dt;
      if (it.x < it.r) { it.x = it.r; it.vx = -it.vx * 0.6; }
      if (it.x > W - it.r) { it.x = W - it.r; it.vx = -it.vx * 0.6; }
      if (it.y + it.r > H) {
        it.y = H - it.r;
        if (it.vy > 0) it.vy = -it.vy * it.bounce;
        it.vx *= 0.92; it.vr *= 0.9;
        if (Math.abs(it.vy) < 30) it.vy = 0;
      }
      if (it.type !== 'spark') {
        for (var j = 0; j < rects.length; j++) {
          var r = rects[j];
          var cx = Math.max(r.left, Math.min(it.x, r.right));
          var cy = Math.max(r.top, Math.min(it.y, r.bottom));
          var dx = it.x - cx, dy = it.y - cy, d2 = dx * dx + dy * dy;
          if (d2 < it.r * it.r) {
            if (d2 === 0) { it.y = r.top - it.r; if (it.vy > 0) it.vy = -it.vy * it.bounce; continue; }
            var d = Math.sqrt(d2), nx = dx / d, ny = dy / d;
            it.x = cx + nx * it.r; it.y = cy + ny * it.r;
            var vn = it.vx * nx + it.vy * ny;
            if (vn < 0) {
              var e = 1 + Math.max(it.bounce, 0.72);
              it.vx -= e * vn * nx; it.vy -= e * vn * ny;
              it.vr += (Math.random() - 0.5) * 8;
            }
          }
        }
      }
    }
    draw();
    if (items.length) raf = requestAnimationFrame(tick);
    else { raf = 0; ctx.setTransform(dpr, 0, 0, dpr, 0, 0); ctx.clearRect(0, 0, W, H); }
  }

  /* shapes */
  function lens(r, c, m) {
    var g = ctx.createRadialGradient(-r * 0.35, -r * 0.4, r * 0.1, 0, 0, r * 1.05);
    g.addColorStop(0, mix(c, 'w', 0.5)); g.addColorStop(0.5, c); g.addColorStop(1, mix(c, 'b', 0.3));
    ctx.fillStyle = g;
    ctx.beginPath(); ctx.arc(0, 0, r, 0, Math.PI * 2); ctx.fill();
    ctx.shadowColor = 'transparent';
    ctx.lineWidth = 1; ctx.strokeStyle = mix(c, 'b', 0.4); ctx.stroke();
    ctx.fillStyle = 'rgba(255,255,255,0.7)';
    ctx.beginPath(); ctx.ellipse(-r * 0.36, -r * 0.4, r * 0.3, r * 0.15, -0.7, 0, Math.PI * 2); ctx.fill();
    if (m) {
      ctx.fillStyle = 'rgba(255,255,255,0.9)';
      ctx.font = '800 ' + Math.round(r * 1.05) + 'px Figtree, sans-serif';
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText('m', 0, r * 0.06);
    }
  }
  function smile(r) {
    var g = ctx.createRadialGradient(-r * 0.3, -r * 0.35, r * 0.1, 0, 0, r * 1.05);
    g.addColorStop(0, '#fff9a6'); g.addColorStop(0.55, '#ffe500'); g.addColorStop(1, '#e0a200');
    ctx.fillStyle = g;
    ctx.beginPath(); ctx.arc(0, 0, r, 0, Math.PI * 2); ctx.fill();
    ctx.shadowColor = 'transparent';
    ctx.lineWidth = Math.max(1.2, r * 0.1); ctx.strokeStyle = '#2a0a1c'; ctx.stroke();
    ctx.fillStyle = '#2a0a1c';
    ctx.beginPath(); ctx.ellipse(-r * 0.33, -r * 0.2, r * 0.11, r * 0.19, 0, 0, Math.PI * 2); ctx.fill();
    ctx.beginPath(); ctx.ellipse(r * 0.33, -r * 0.2, r * 0.11, r * 0.19, 0, 0, Math.PI * 2); ctx.fill();
    ctx.lineCap = 'round'; ctx.lineWidth = Math.max(1.4, r * 0.13);
    ctx.beginPath(); ctx.arc(0, r * 0.05, r * 0.55, 0.2 * Math.PI, 0.8 * Math.PI); ctx.stroke();
  }
  function star(r, c) {
    var R = r * 1.4, q = r * 0.4;
    ctx.beginPath();
    for (var i = 0; i < 8; i++) {
      var a = i * Math.PI / 4 - Math.PI / 2, rad = i % 2 === 0 ? R : q;
      ctx.lineTo(Math.cos(a) * rad, Math.sin(a) * rad);
    }
    ctx.closePath();
    ctx.fillStyle = c; ctx.fill();
    ctx.shadowColor = 'transparent';
    ctx.lineWidth = 1.2; ctx.strokeStyle = 'rgba(255,255,255,0.85)'; ctx.stroke();
  }
  function heart(r, c) {
    var g = ctx.createRadialGradient(-r * 0.3, -r * 0.4, r * 0.1, 0, 0, r * 1.3);
    g.addColorStop(0, mix(c, 'w', 0.5)); g.addColorStop(0.6, c); g.addColorStop(1, mix(c, 'b', 0.3));
    ctx.beginPath();
    ctx.moveTo(0, r * 0.95);
    ctx.bezierCurveTo(-r * 1.7, -r * 0.1, -r * 0.8, -r * 1.25, 0, -r * 0.45);
    ctx.bezierCurveTo(r * 0.8, -r * 1.25, r * 1.7, -r * 0.1, 0, r * 0.95);
    ctx.fillStyle = g; ctx.fill();
    ctx.shadowColor = 'transparent';
    ctx.fillStyle = 'rgba(255,255,255,0.65)';
    ctx.beginPath(); ctx.ellipse(-r * 0.55, -r * 0.45, r * 0.22, r * 0.11, -0.6, 0, Math.PI * 2); ctx.fill();
  }
  function disco(r) {
    var g = ctx.createRadialGradient(-r * 0.35, -r * 0.4, r * 0.1, 0, 0, r * 1.05);
    g.addColorStop(0, '#ffffff'); g.addColorStop(0.5, '#c9c9d6'); g.addColorStop(1, '#6b6b80');
    ctx.fillStyle = g;
    ctx.beginPath(); ctx.arc(0, 0, r, 0, Math.PI * 2); ctx.fill();
    ctx.shadowColor = 'transparent';
    ctx.save();
    ctx.beginPath(); ctx.arc(0, 0, r, 0, Math.PI * 2); ctx.clip();
    ctx.strokeStyle = 'rgba(40,20,70,0.35)'; ctx.lineWidth = 1;
    var k;
    for (k = -2; k <= 2; k++) { ctx.beginPath(); ctx.moveTo(-r, k * r / 3); ctx.lineTo(r, k * r / 3); ctx.stroke(); }
    for (k = 1; k <= 3; k++) { ctx.beginPath(); ctx.ellipse(0, 0, k * r / 3.4, r, 0, 0, Math.PI * 2); ctx.stroke(); }
    ctx.fillStyle = 'rgba(255,46,147,0.55)'; ctx.fillRect(-r * 0.5, -r * 0.1, r * 0.3, r * 0.3);
    ctx.fillStyle = 'rgba(0,229,255,0.55)'; ctx.fillRect(r * 0.15, -r * 0.55, r * 0.3, r * 0.3);
    ctx.fillStyle = 'rgba(255,229,0,0.55)'; ctx.fillRect(r * 0.05, r * 0.25, r * 0.3, r * 0.3);
    ctx.restore();
    ctx.lineWidth = 1; ctx.strokeStyle = 'rgba(40,20,70,0.5)';
    ctx.beginPath(); ctx.arc(0, 0, r, 0, Math.PI * 2); ctx.stroke();
  }

  function draw() {
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, W, H);
    for (var i = 0; i < items.length; i++) {
      var it = items[i];
      var a = Math.min(1, (it.life - it.age) / 0.8);
      ctx.save();
      ctx.globalAlpha = Math.max(0, a);
      ctx.translate(it.x, it.y);
      ctx.rotate(it.rot);
      if (it.type === 'spark') {
        ctx.shadowColor = it.color; ctx.shadowBlur = rave ? 10 : 5;
        ctx.fillStyle = it.color;
        ctx.fillRect(-it.r, -it.r, it.r * 2, it.r * 2);
      } else if (it.type === 'emoji') {
        ctx.font = Math.round(it.r * 1.8) + 'px sans-serif';
        ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.fillText(it.ch, 0, 0);
      } else {
        if (rave) { ctx.shadowColor = it.color; ctx.shadowBlur = 16; }
        else { ctx.shadowColor = 'rgba(60,0,30,0.3)'; ctx.shadowBlur = 5; ctx.shadowOffsetY = 2; }
        if (it.shape === 'smile') smile(it.r);
        else if (it.shape === 'star') star(it.r, it.color);
        else if (it.shape === 'heart') heart(it.r, it.color);
        else if (it.shape === 'disco') disco(it.r);
        else lens(it.r, it.color, it.m);
      }
      ctx.restore();
    }
  }

  function burst(x, y, emoji, smileBoost) {
    var pops = palette('pop', 6);
    var i, s;
    var plan = reduce ? { lens: 5, smile: 2, star: 1, heart: 1, disco: 0, emoji: 2, spark: 0 }
      : { lens: 7, smile: smileBoost ? 16 : 3, star: 3, heart: 2, disco: 2, emoji: 4, spark: 24 };
    for (s in plan) {
      if (s === 'emoji' || s === 'spark') continue;
      for (i = 0; i < plan[s]; i++) {
        spawn({ type: 'candy', shape: s, x: x, y: y, r: s === 'disco' ? rnd(12, 16) : rnd(9, 15),
          vx: rnd(-400, 400), vy: -rnd(320, 820), rot: rnd(0, 6), vr: rnd(-8, 8),
          color: pick(pops), m: Math.random() < 0.5, life: rnd(3.2, 4.8), bounce: 0.62 });
      }
    }
    for (i = 0; i < plan.emoji; i++) {
      spawn({ type: 'emoji', x: x, y: y, r: rnd(12, 18), vx: rnd(-280, 280), vy: -rnd(300, 700), vr: rnd(-2, 2),
        ch: (i === 0 && emoji) ? emoji : pick(EMOJI), life: rnd(2.4, 3.4), bounce: 0.5 });
    }
    for (i = 0; i < plan.spark; i++) {
      spawn({ type: 'spark', x: x, y: y, r: rnd(1, 2.4), vx: rnd(-420, 420), vy: -rnd(100, 600),
        color: Math.random() < 0.5 ? '#ffffff' : pick(pops), life: rnd(0.6, 1.2), bounce: 0.3 });
    }
    crackle(reduce ? 4 : 10);
  }

  function rain() {
    if (reduce) return;
    var cs = palette('candy', 4), shapes = rave ? ['lens', 'lens', 'smile', 'star', 'heart', 'disco'] : ['lens', 'lens', 'lens', 'lens', 'lens', 'heart'];
    for (var i = 0; i < 46; i++) {
      (function (i) {
        setTimeout(function () {
          var sh = pick(shapes);
          spawn({ type: 'candy', shape: sh, x: rnd(16, W - 16), y: -20, r: sh === 'disco' ? rnd(12, 16) : rnd(8, 14),
            vx: rnd(-60, 60), vy: rnd(50, 250), rot: rnd(0, 6), vr: rnd(-5, 5), color: pick(cs),
            m: Math.random() < 0.45, life: rnd(4.5, 6.5), bounce: 0.58 });
        }, 300 + i * 55);
      })(i);
    }
  }
  rain();

  document.addEventListener('pointerdown', function (e) {
    if (e.target.closest && e.target.closest('a')) return;
    var em = e.target.closest && e.target.closest('[data-emoji]');
    var sm = e.target.closest && e.target.closest('[data-smile]');
    burst(e.clientX, e.clientY, em ? em.getAttribute('data-emoji') : '', !!sm);
  });

  /* rave mode */
  var raveBtns = document.querySelectorAll('.rave-btn');
  function setRave(on) {
    rave = on;
    if (on) root.setAttribute('data-rave', 'on'); else root.removeAttribute('data-rave');
    for (var i = 0; i < raveBtns.length; i++) {
      raveBtns[i].setAttribute('aria-pressed', String(on));
      raveBtns[i].textContent = raveBtns[i].getAttribute(on ? 'data-on' : 'data-off');
    }
    if (on) { rain(); crackle(16); }
  }
  for (var rb = 0; rb < raveBtns.length; rb++) {
    raveBtns[rb].addEventListener('click', function () { setRave(!rave); });
  }
  var lastMove = 0;
  document.addEventListener('pointermove', function (e) {
    if (!rave || reduce) return;
    var t = performance.now();
    if (t - lastMove < 45) return;
    lastMove = t;
    var pops = palette('pop', 6);
    for (var i = 0; i < 2; i++) {
      spawn({ type: 'spark', x: e.clientX, y: e.clientY, r: rnd(1.2, 2.6), vx: rnd(-90, 90), vy: rnd(-120, 40),
        color: pick(pops), life: rnd(0.5, 0.9), bounce: 0.3 });
    }
    if (Math.random() < 0.18) {
      spawn({ type: 'candy', shape: pick(['star', 'smile', 'heart']), x: e.clientX, y: e.clientY, r: rnd(7, 10),
        vx: rnd(-80, 80), vy: rnd(-200, -60), rot: rnd(0, 6), vr: rnd(-6, 6), color: pick(pops), life: rnd(1.4, 2.2), bounce: 0.5 });
    }
  });

  /* zipper */
  var zip = document.getElementById('zip');
  zip.addEventListener('click', function () {
    if (zip.classList.contains('run')) return;
    zip.classList.add('run');
    zipSound();
    setTimeout(function () { zip.classList.remove('run'); }, 1400);
  });

  /* copy buttons */
  var copies = document.querySelectorAll('.copy');
  for (var c = 0; c < copies.length; c++) {
    copies[c].addEventListener('click', function (e) {
      var btn = e.currentTarget;
      var el = document.getElementById(btn.getAttribute('data-copy'));
      var text = el.textContent.trim();
      function done() { btn.textContent = 'Copied'; setTimeout(function () { btn.textContent = 'Copy'; }, 1500); }
      function fallback() {
        var rg = document.createRange(); rg.selectNodeContents(el);
        var sel = window.getSelection(); sel.removeAllRanges(); sel.addRange(rg);
        btn.textContent = 'Selected';
        setTimeout(function () { btn.textContent = 'Copy'; }, 1500);
      }
      try { navigator.clipboard.writeText(text).then(done, fallback); } catch (err) { fallback(); }
    });
  }
})();

</script>

</body>
</html>
