  function css(n) { return getComputedStyle(root).getPropertyValue(n).trim(); }
  function palette(prefix, count) { var out = []; for (var i = 1; i <= count; i++) out.push(css('--' + prefix + '-' + i)); return out; }
  function rnd(a, b) { return a + Math.random() * (b - a); }
  function pick(arr) { return arr[Math.floor(Math.random() * arr.length)]; }
  function rgb(h) {
    h = String(h).replace('#', '');
    if (h.length === 3) h = h.split('').map(function (c) { return c + c; }).join('');
    var n = parseInt(h, 16);
    if (isNaN(n)) return [255, 120, 170];
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  }
  function mix(h, to, a) {
    var c = rgb(h), k = to === 'w' ? 255 : 0;
    return 'rgb(' + c.map(function (v) { return Math.round(v + (k - v) * a); }).join(',') + ')';
  }

  /* greeting from the QR link (#dublin-club -> Dublin Club) */
  try {
    var raw = decodeURIComponent((location.hash || '').replace(/^#/, ''));
    if (raw && !/^(top|played|tour|music|story|press|book)$/.test(raw)) {
      var nice = raw.replace(/[-_.~]+/g, ' ').trim().slice(0, 40).replace(/\b\w/g, function (c) { return c.toUpperCase(); });
      if (nice) document.getElementById('who').textContent = nice;
    }
  } catch (e) {}

  /* sound */
  var ac = null, nb = null, muted = false;
  function audio() {
    if (!ac) { try { ac = new (window.AudioContext || window.webkitAudioContext)(); } catch (e) { ac = null; } }
    if (ac && ac.state === 'suspended') { try { ac.resume(); } catch (e) {} }
    return ac;
  }
  function click(a, when, hp, vol) {
    if (!nb) {
      nb = a.createBuffer(1, Math.floor(a.sampleRate * 0.03), a.sampleRate);
      var d = nb.getChannelData(0);
      for (var i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / d.length);
    }
    var s = a.createBufferSource(); s.buffer = nb; s.playbackRate.value = rnd(0.7, 1.9);
    var f = a.createBiquadFilter(); f.type = 'highpass'; f.frequency.value = hp;
    var g = a.createGain(); g.gain.value = vol;
    s.connect(f); f.connect(g); g.connect(a.destination);
    s.start(a.currentTime + when);
  }
  function crackle(n) {
    if (muted) return;
    var a = audio(); if (!a) return;
    for (var i = 0; i < n; i++) click(a, Math.random() * 0.45, rnd(2500, 5500), rnd(0.05, 0.17));
  }
  function zipSound() {
    if (muted) return;
    var a = audio(); if (!a) return;
    for (var i = 0; i < 22; i++) click(a, i * 0.04, 1800 + i * 90, 0.09);
  }
  var sndBtn = document.getElementById('snd');
  sndBtn.addEventListener('click', function (e) {
