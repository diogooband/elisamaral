<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<style>:root{color-scheme:light;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}body{margin:0}img{max-width:100%}[hidden]{display:none!important}</style>
<title>Elisa Amaral EPK</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bagel+Fat+One&family=Figtree:wght@400;500;700;800&family=DM+Mono:wght@400;500&display=swap">
<style>
/* Layout: split hero (wavy-blob photo beside a rose panel with her logo), scrolling ribbon, flower badges, pill tour tablets, checkerboard socials. Rose only; colour arrives when you tap. */
:root {
  --bg: #fff1f4;
  --blush: #ffd5e1;
  --panel: #c23a6e;
  --panel-ink: #fff1f4;
  --ink: #3b1224;
  --muted: #7d4a62;
  --rose: #e88aa5;
  --hot: #e5568a;
  --line: #f2bccd;
  --bub-1: #ff9bbd;
  --bub-2: #ee5f90;
  --bub-3: #c23a6e;
  --bub-edge: #8f2850;
  --candy-1: #ffc2d6;
  --candy-2: #f48fb1;
  --candy-3: #c23a6e;
  --candy-4: #ffe3ec;
  --pop-1: #ff2e93;
  --pop-2: #ffe500;
  --pop-3: #00e5ff;
  --pop-4: #9b5cff;
  --pop-5: #b6ff00;
  --pop-6: #ff7a00;
  --display: "Bagel Fat One", "Arial Rounded MT Bold", "Arial Black", sans-serif;
  --body: "Figtree", system-ui, -apple-system, "Segoe UI", sans-serif;
  --mono: "DM Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #26091a; --blush: #3d1229; --panel: #a3305f; --panel-ink: #fff1f4;
    --ink: #ffe3eb; --muted: #dba3b8; --rose: #f29bb5; --hot: #ff7aa8; --line: #5a2540;
    --bub-1: #ffc0d6; --bub-2: #ff8fb5; --bub-3: #e5568a; --bub-edge: #5a1a38;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #26091a; --blush: #3d1229; --panel: #a3305f; --panel-ink: #fff1f4;
  --ink: #ffe3eb; --muted: #dba3b8; --rose: #f29bb5; --hot: #ff7aa8; --line: #5a2540;
  --bub-1: #ffc0d6; --bub-2: #ff8fb5; --bub-3: #e5568a; --bub-edge: #5a1a38;
  color-scheme: dark;
}
* { box-sizing: border-box; }
html { scroll-behavior: auto; }
@media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }
body {
  background-color: var(--bg); color: var(--ink);
  font: 400 1rem/1.6 var(--body);
  padding-inline: clamp(1rem, 4vw, 2.5rem); padding-block: 1rem 3rem; overflow-x: hidden;
}
.wrap { max-width: 64rem; margin-inline: auto; display: grid; gap: clamp(3rem, 8vw, 5rem); }
a { color: inherit; }
:focus-visible { outline: 3px solid var(--hot); outline-offset: 3px; }
#fx { position: fixed; inset: 0; z-index: 50; pointer-events: none; }
.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
.mono { font-family: var(--mono); font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; }

/* bubble type */
.bub {
  font-family: var(--display); font-weight: 400; line-height: 1.05; letter-spacing: .01em;
  background-image: linear-gradient(180deg, var(--bub-1) 0%, var(--bub-2) 52%, var(--bub-3) 100%);
  -webkit-background-clip: text; background-clip: text; color: transparent; -webkit-text-fill-color: transparent;
  filter: drop-shadow(0 .05em 0 var(--bub-edge));
  text-wrap: balance;
}
.panel { --bub-1: #ffffff; --bub-2: #fff1f4; --bub-3: #ffc2d6; --bub-edge: #7a1f45; }

/* nav */
.nav {
  max-width: 64rem; margin: 0 auto 1.25rem; background: var(--panel); color: var(--panel-ink);
  border-radius: 2rem; padding: .6rem 1rem; display: flex; flex-wrap: wrap; align-items: center; gap: .4rem 1rem;
}
.nav .brand { font: 400 1.5rem/1 var(--display); text-decoration: none; letter-spacing: .02em; }
.nav ul { order: 3; flex: 1 1 100%; display: flex; gap: .3rem 1.1rem; list-style: none; margin: 0; padding: 0; overflow-x: auto; }
.nav li a { display: block; padding: .3rem 0; text-decoration: none; font: 700 .85rem var(--body); white-space: nowrap; }
.nav li a:hover { text-decoration: underline; text-underline-offset: .25em; }
.nav .chip { margin-left: auto; }
@media (min-width: 760px) { .nav ul { order: 0; flex: 0 1 auto; margin-left: 1.5rem; } }
.chip {
  font: 500 .72rem var(--mono); letter-spacing: .08em; text-transform: uppercase;
  background: var(--panel-ink); color: var(--panel); border: 0; border-radius: 999px; padding: .45rem .85rem; cursor: pointer;
}
.chip[aria-pressed="false"] { background: transparent; color: var(--panel-ink); outline: 1.5px solid var(--panel-ink); }

/* hero */
.hero { display: grid; border-radius: 2rem; overflow: hidden; }
@media (min-width: 760px) { .hero { grid-template-columns: 1fr 1.05fr; } .hero .photo-side { order: -1; } }
.text-side {
  background: var(--panel); color: var(--panel-ink); display: grid; gap: 1.1rem; justify-items: start; align-content: center;
  padding: clamp(1.5rem, 5vw, 3rem); min-width: 0;
}
.stamp { margin: 0; font: 500 .72rem var(--mono); letter-spacing: .14em; text-transform: uppercase; border: 1.5px dashed currentColor; padding: .4rem .8rem; border-radius: .4rem; transform: rotate(-2deg); }
.hi { margin: 0; opacity: .92; }
.hi b { font-weight: 800; }
.logo {
  --m: url("data:image/png;base64,");
  margin: 0; width: min(100%, 19rem); aspect-ratio: 900 / 978; background: var(--panel-ink);
  -webkit-mask: var(--m) center / contain no-repeat; mask: var(--m) center / contain no-repeat;
}
.lede { margin: 0; max-width: 28rem; font-size: 1.1rem; }
.cta { display: flex; flex-wrap: wrap; gap: .7rem; }
.pill {
  display: inline-block; text-decoration: none; font: 800 .9rem var(--body); letter-spacing: .02em;
  background: var(--panel-ink); color: var(--panel); border: 2px solid var(--panel-ink); border-radius: 999px; padding: .65rem 1.3rem; cursor: pointer;
}
.pill.ghost { background: transparent; color: var(--panel-ink); }
.pill.dark { background: var(--panel); color: var(--panel-ink); border-color: var(--panel); }
.pill.line { background: transparent; color: var(--ink); border-color: var(--ink); }
.hint { margin: 0; opacity: .85; }
.photo-side { position: relative; background: var(--blush); display: grid; place-items: center; padding: clamp(1.5rem, 5vw, 3rem); min-height: 18rem; }
.blobs { position: relative; width: min(100%, 25rem); aspect-ratio: 1; }
.blobs .back, .blobs img { position: absolute; inset: 0; width: 100%; height: 100%; clip-path: url(#blob); }
.blobs .back { background: var(--hot); transform: translate(.9rem, .9rem) rotate(8deg); }
.blobs img { object-fit: cover; object-position: 50% 20%; }
.star { position: absolute; color: var(--panel); width: 1.6rem; height: 1.6rem; }

/* ribbon */
.ribbon { overflow: hidden; background: var(--hot); color: #fff; border-radius: 999px; padding: .7rem 0; }
.track { display: flex; width: max-content; gap: 0; animation: slide 38s linear infinite; }
.track span { font: 800 .95rem var(--body); letter-spacing: .02em; white-space: nowrap; padding-inline: 1.1rem; }
@keyframes slide { to { transform: translateX(-50%); } }

/* sections */
.sec { display: grid; gap: 1.4rem; min-width: 0; }
.sec h2 { margin: .3rem 0 0; font-size: clamp(2rem, 7vw, 3.2rem); }
.sec p { margin: 0; max-width: 42rem; }
.todo { background: color-mix(in srgb, var(--rose) 25%, transparent); outline: 1.5px dashed var(--hot); outline-offset: 1px; border-radius: .25rem; padding: 0 .3em; }

.trio { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 1.5rem; }
.badge { display: grid; justify-items: center; text-align: center; gap: .6rem; cursor: pointer; }
.flower { position: relative; width: 8.5rem; height: 8.5rem; color: var(--hot); display: grid; place-items: center; }
.flower svg { position: absolute; inset: 0; width: 100%; height: 100%; }
.flower .abbr { position: relative; font: 400 2rem/1 var(--display); color: #fff; text-shadow: 0 .05em 0 var(--bub-edge); }
.badge h3 { margin: 0; font: 800 1.1rem var(--body); }
.badge p { font-size: .95rem; color: var(--muted); }

.tablets { display: grid; grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr)); gap: .9rem; }
.tablet {
  display: grid; gap: .1rem; justify-items: center; text-align: center; background: var(--blush); color: var(--ink);
  border: 1.5px solid var(--line); border-radius: 3rem; padding: 1.4rem 1rem 1.3rem; cursor: pointer; font: inherit;
  transition: transform .15s ease, background .15s ease;
}
.tablet:hover { background: color-mix(in srgb, var(--rose) 40%, var(--blush)); }
.tablet:active { transform: scale(.96); }
.tablet .day { font: 400 1.7rem/1.1 var(--display); text-transform: uppercase; color: var(--panel); }
.tablet .city { font-weight: 800; font-size: 1.05rem; }
.tablet .venue { color: var(--muted); font-size: .9rem; }
.note { color: var(--muted); }

.rels { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1rem; }
.rel { display: grid; align-content: start; gap: .5rem; background: var(--blush); border-radius: 1.5rem 3rem 1.5rem 1.5rem; padding: 1.4rem; min-width: 0; }
.rel .kind { color: var(--muted); }
.rel h3 { margin: 0; font: 400 1.5rem/1.1 var(--display); color: var(--panel); }
.rel .by { font-weight: 700; margin: 0; }
.rel .fact { color: var(--muted); margin: 0; }
.rel .links { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .4rem; }
.rel .pill { font-size: .8rem; padding: .45rem 1rem; }
.labels { display: flex; flex-wrap: wrap; gap: .5rem; padding: 0; margin: 0; list-style: none; }
.labels li { border: 1.5px solid var(--ink); border-radius: 999px; padding: .3rem .9rem; font-weight: 700; font-size: .9rem; }
.labels li.own { background: var(--ink); color: var(--bg); }

.story { display: grid; gap: 2rem; align-items: center; }
@media (min-width: 760px) { .story { grid-template-columns: 1fr 1.2fr; } }
.story .blobs { width: min(100%, 22rem); justify-self: center; }
.story .blobs .back { background: var(--rose); transform: translate(-.8rem, .8rem) rotate(-7deg); }
.time { list-style: none; margin: 0; padding: 0; display: grid; gap: .9rem; }
.time li { display: grid; grid-template-columns: 4.2rem 1fr; gap: .8rem; align-items: baseline; }
.time .yr { font: 400 1.4rem/1 var(--display); color: var(--panel); }
.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: 1.4rem 1rem; margin: 0; }
.stats div { display: grid; gap: .2rem; align-content: start; }
.stats dt { order: 2; font: 500 .72rem var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
.stats dd { margin: 0; font: 400 clamp(2rem, 6vw, 2.8rem)/1 var(--display); color: var(--panel); }

.press { list-style: none; margin: 0; padding: 0; display: grid; }
.press li a { display: grid; gap: .1rem; padding: .9rem 0; border-bottom: 1.5px solid var(--line); text-decoration: none; }
.press li a:hover .t { text-decoration: underline; text-underline-offset: .2em; }
.press .o { color: var(--muted); }
.press .t { font-weight: 700; }

.checker {
  background: conic-gradient(var(--panel) 25%, var(--blush) 0 50%, var(--panel) 0 75%, var(--blush) 0) 0 0 / 3rem 3rem;
  border-radius: 2rem; padding: clamp(1rem, 4vw, 2rem);
}
.checker .card { background: var(--bg); border-radius: 1.5rem 3rem 1.5rem 1.5rem; padding: clamp(1.3rem, 4vw, 2.2rem); display: grid; gap: 1rem; justify-items: start; }
.checker h2 { margin: 0; font-size: clamp(2rem, 7vw, 3rem); }
.socials { display: flex; flex-wrap: wrap; gap: .6rem; }

.bag {
  position: relative; display: grid; gap: 1.1rem; padding: 3.4rem clamp(1.1rem, 4vw, 2rem) 1.6rem;
  border: 2px solid var(--ink); border-radius: .75rem 3rem .75rem .75rem; background: color-mix(in srgb, var(--blush) 70%, transparent);
}
.bag h2 { margin: 0; font-size: clamp(2rem, 7vw, 3rem); }
.zip { position: absolute; left: 1rem; right: 1rem; top: .8rem; height: 2rem; border: 0; background: none; cursor: pointer; padding: 0; }
.zip::before { content: ""; position: absolute; left: 0; right: 0; top: 50%; border-top: 3px dotted var(--ink); }
.zip .pull { position: absolute; top: 0; left: 0; width: 2.6rem; height: 2rem; border-radius: 999px; background: var(--hot); border: 2px solid var(--ink); transition: left .9s cubic-bezier(.6, 0, .3, 1); }
.zip.run .pull { left: calc(100% - 2.6rem); }
.zip .lbl { position: absolute; right: 0; top: -1.1rem; font: 500 .7rem var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
.contact { display: grid; gap: .8rem; margin: 0; padding: 0; list-style: none; }
.contact li { display: flex; flex-wrap: wrap; gap: .3rem .9rem; align-items: center; min-width: 0; }
.contact .k { font: 500 .72rem var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--muted); min-width: 6.5rem; }
.contact .v { font-weight: 800; overflow-wrap: anywhere; min-width: 0; }
.copy { font: 700 .8rem var(--body); background: transparent; color: var(--ink); border: 1.5px solid var(--ink); border-radius: 999px; padding: .3rem .8rem; cursor: pointer; }
footer { color: var(--muted); }

@media (prefers-reduced-motion: reduce) { .track { animation: none; } .tablet, .zip .pull { transition: none; } }

/* ---- v3: fun layer, stickers, tilt, rave mode ---- */
body { transition: background-color .5s ease, color .5s ease; }
.nav, .wrap { position: relative; z-index: 1; }
.nav .brand { display: inline-block; }
.chips { margin-left: auto; display: flex; gap: .5rem; flex-wrap: wrap; justify-content: flex-end; }
.nav .chip { margin-left: 0; }

.tablet { rotate: var(--tilt, 0deg); transition: transform .15s ease, background .15s ease, rotate .2s ease; }
.tablet:hover { rotate: calc(var(--tilt, 0deg) * -1.6); }
.rel:nth-child(odd) { rotate: -1deg; }
.rel:nth-child(even) { rotate: 1deg; }

.sticker { position: absolute; border: 0; padding: 0; background: none; cursor: pointer; }
.sticker.smile { left: 6%; bottom: 7%; width: 4.4rem; height: 4.4rem; animation: spin 10s linear infinite; }
.sticker.smile svg { width: 100%; height: 100%; display: block; }
.sticker.bpm {
  right: 6%; top: 7%; width: 4.8rem; height: 4.8rem; border-radius: 50%; background: var(--ink); color: var(--bg);
  display: grid; place-content: center; text-align: center; rotate: 12deg; font: 400 .85rem/1 var(--display); cursor: default;
}
.sticker.bpm b { font: 400 1.6rem/1 var(--display); color: var(--hot); }
@keyframes spin { to { rotate: 360deg; } }

.eq { display: inline-flex; align-items: flex-end; gap: 2px; height: .9rem; margin-left: .7rem; vertical-align: middle; }
.eq i { width: 3px; height: 30%; background: currentColor; border-radius: 1px; animation: eq .48s ease-in-out infinite alternate; }
.eq i:nth-child(2) { animation-delay: -.12s; } .eq i:nth-child(3) { animation-delay: -.24s; }
.eq i:nth-child(4) { animation-delay: -.06s; } .eq i:nth-child(5) { animation-delay: -.3s; }
@keyframes eq { to { height: 100%; } }

.lasers { position: fixed; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; opacity: 0; transition: opacity .6s; mix-blend-mode: screen; }
.lasers i { position: absolute; left: 50%; top: 0; width: 160vmax; height: 160vmax; margin: -80vmax 0 0 -80vmax; animation: sweep 5s ease-in-out infinite alternate; }
.lasers .b1 { background: repeating-conic-gradient(from 0deg, rgba(255, 46, 147, .5) 0 2deg, transparent 2deg 22deg); }
.lasers .b2 { background: repeating-conic-gradient(from 8deg, rgba(0, 229, 255, .42) 0 1.5deg, transparent 1.5deg 26deg); animation-duration: 7s; animation-direction: alternate-reverse; }
@keyframes sweep { from { transform: rotate(-35deg); } to { transform: rotate(35deg); } }

@keyframes beat { 0% { transform: scale(1.08); } 45%, 100% { transform: scale(1); } }

:root[data-rave="on"] {
  --bg: #0d0220; --blush: #1c0540; --panel: #7a1fd1; --panel-ink: #ffffff;
  --ink: #f6ecff; --muted: #c9a8ff; --rose: #ff3ea5; --hot: #ff2e93; --line: #3b1470;
  --bub-1: #fff36b; --bub-2: #ff4fc3; --bub-3: #8f5bff; --bub-edge: #2a0a5c;
  --candy-1: #ff2e93; --candy-2: #ffe500; --candy-3: #00e5ff; --candy-4: #b6ff00;
  color-scheme: dark;
}
:root[data-rave="on"] .lasers { opacity: .32; }
:root[data-rave="on"] .bub { filter: drop-shadow(0 .05em 0 var(--bub-edge)) drop-shadow(0 0 .35em color-mix(in srgb, var(--hot) 65%, transparent)); }
:root[data-rave="on"] .panel { --bub-1: #ffffff; --bub-2: #fff1f4; --bub-3: #ffc2d6; --bub-edge: #2a0a5c; }
:root[data-rave="on"] .ribbon { background: linear-gradient(90deg, #ff2e93, #8f5bff, #00e5ff); }
:root[data-rave="on"] .track { animation-duration: 18s; }
:root[data-rave="on"] .flower, :root[data-rave="on"] .sticker.bpm, :root[data-rave="on"] .nav .brand { animation: beat .4839s ease-out infinite; }
:root[data-rave="on"] .sticker.bpm { background: #ffe500; color: #2a0a1c; }
:root[data-rave="on"] .tablet, :root[data-rave="on"] .rel { box-shadow: 0 0 1.2rem color-mix(in srgb, var(--hot) 45%, transparent); }
:root[data-rave="on"] .checker { background: conic-gradient(#7a1fd1 25%, #0d0220 0 50%, #7a1fd1 0 75%, #0d0220 0) 0 0 / 3rem 3rem; }
:root[data-rave="on"] .blobs .back { box-shadow: none; filter: drop-shadow(0 0 1rem var(--hot)); }

@media (prefers-reduced-motion: reduce) {
  .sticker.smile, .eq i, .lasers i, :root[data-rave="on"] .flower, :root[data-rave="on"] .sticker.bpm, :root[data-rave="on"] .nav .brand { animation: none; }
}

</style>

</head>
<body>
<canvas id="fx" aria-hidden="true"></canvas>
<div class="lasers" aria-hidden="true"><i class="b1"></i><i class="b2"></i></div>
